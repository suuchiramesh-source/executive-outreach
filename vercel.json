{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/accounts/*.js": {
      "maxDuration": 60
    },
    "api/enrich.js": {
      "maxDuration": 60
    },
    "api/verify-emails.js": {
      "maxDuration": 60
    },
    "api/create-draft.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "executive-outreach.vercel.app" }],
      "destination": "https://executive-intelligence.vercel.app/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
