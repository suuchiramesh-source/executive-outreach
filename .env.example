# Google Sheets API — use a service account JSON key
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Apollo.io API key
APOLLO_API_KEY=your_apollo_api_key_here

# Salesforce (optional — for cross-reference signal)
SF_INSTANCE_URL=https://yourorg.my.salesforce.com
SF_ACCESS_TOKEN=your_salesforce_access_token_here

# Hunter.io email verification
HUNTER_API_KEY=your_hunter_api_key_here

# App password (for Replit deployment)
APP_PASSWORD=your_shared_password_here

# Server
PORT=3000
